---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Faqs from '../../components/Faqs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, serviceById, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const [lead, ...rest] = service.photos;
const topics: Record<string, string> = {
  kitchen: 'kitchen remodeling',
  bathroom: 'bathroom remodeling',
  flooring: 'flooring installation',
  roofing: 'roofing',
  decks: 'deck building',
  porches: 'a porch, addition or shed',
  concrete: 'concrete work',
  windows: 'window installation',
  walls: 'drywall work',
  remodel: 'whole-home remodeling',
};
const lower = topics[service.id];
const pageUrl = `${site.url}/services/${service.id}`;
const allFaqs = [
  ...service.faqs,
  { q: `How much does ${lower} cost in Morganton?`, a: `${service.costIntro}` },
];
const steps = [
  { t: 'Tell us about the job', d: 'Answer a few quick questions, or call us.' },
  { t: 'We come out', d: 'Pick a time and we look at the job with you.' },
  { t: 'You get a price', d: 'The estimate is free, and you decide from there.' },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.answer,
    url: pageUrl,
    provider: { '@id': `${site.url}/#business` },
    areaServed: site.areas.map((name) => ({ '@type': 'City', name: `${name}, NC` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>`;
const crumbs = [
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.id}` },
];
---
<Base title={service.title} description={service.metaDescription} schema={schema} service={service.id} breadcrumbs={crumbs}>
  <section class="relative bg-spruce-deep text-white overflow-hidden mt-2.5">
    <div class="relative h-[200px] md:absolute md:inset-y-0 md:right-0 md:h-auto md:w-[55%] overflow-hidden">
      <Photo file={lead.file} alt={lead.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 55vw, 100vw" eager class="hero-photo w-full h-full object-cover" />
      <div class="hero-fade hidden md:block absolute inset-0" aria-hidden="true"></div>
      <div class="md:hidden absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-spruce-deep to-transparent" aria-hidden="true"></div>
    </div>
    <div class="wrap relative md:min-h-[26rem] md:flex md:items-center">
      <div class="py-6 md:py-14 md:max-w-[34rem]">
        <h1 class="rise" style="--i:0">{service.h1}</h1>
        <p class="rise mt-4 text-white/85 text-[1.075rem] max-w-[34rem]" style="--i:1">{service.intro}</p>
        <div class="rise mt-6 flex flex-col md:flex-row gap-2.5" style="--i:2">
          <a href="/book" data-wizard={service.id} data-source="service-hero" class="btn btn-primary btn-md-auto md:!px-8">
            Get My Free Estimate
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={site.phoneHref} class="btn btn-outline-light btn-md-auto md:!px-6">Call {site.phone}</a>
        </div>
        <ul class="rise mt-5 flex flex-wrap gap-x-5 gap-y-1.5 font-semibold text-[0.95rem] text-white/90" style="--i:3">
          {['Licensed and insured', '10+ years', 'Se habla español'].map((t) => (
            <li class="flex items-center gap-1.5"><span class="text-tape-soft" set:html={check} />{t}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="ruler" aria-hidden="true"></div>
  </section>

  <section class="wrap section md:grid md:grid-cols-2 md:gap-14">
    <div class="reveal">
      <h2 class="mb-3 max-w-[18ch]">What does {lower} include?</h2>
      <p class="mb-5 max-w-[56ch]">{service.answer}</p>
      <ul class="prose-list space-y-2">
        {service.includes.map((item) => <li class="font-semibold">{item}</li>)}
      </ul>
    </div>
    <div class="mt-10 md:mt-0 reveal">
      <h2 class="mb-3">Who is this for?</h2>
      <ul class="prose-list space-y-2">
        {service.bestFor.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="bg-mist">
      <div class="wrap section">
        <h2 class="mb-6 reveal">Photos of our work</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 md:gap-3">
          {rest.map((p) => (
            <div class="overflow-hidden rounded-md bg-spruce">
              <Photo file={p.file} alt={p.alt} class="reveal-img w-full aspect-[4/5] object-cover hover:scale-[1.03] transition-transform duration-500" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-spruce text-white">
    <div class="wrap section md:grid md:grid-cols-[1.1fr_1fr] md:gap-14">
      <div class="reveal">
        <h2 class="mb-3 max-w-[20ch]">How much does {lower} cost in Morganton?</h2>
        <p class="max-w-[56ch] text-white/90">{service.costIntro}</p>
        <p class="mt-5 text-white/85 max-w-[56ch]">We do not list prices online because every job is different. The estimate is free, and we offer 5% off our services.</p>
        <a href="/book" data-wizard={service.id} data-source="service-cost" class="btn btn-primary mt-6 md:max-w-[17rem]">Get My Free Estimate</a>
      </div>
      <div class="mt-9 md:mt-0 reveal">
        <p class="font-display font-extrabold text-tape-soft text-[1.15rem] mb-3" style="font-stretch:108%">What changes the price</p>
        <ul class="border-t border-white/20">
          {service.costFactors.map((item) => <li class="py-3 border-b border-white/20">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="wrap section">
      <h2 class="mb-8 reveal">What happens after I book?</h2>
      <ol class="grid gap-7 md:grid-cols-3 md:gap-8">
        {steps.map((s, i) => (
          <li class="reveal border-t-4 border-spruce pt-4 relative">
            <span class="absolute -top-[4px] left-0 h-[4px] w-14 bg-tape" aria-hidden="true"></span>
            <span class="block font-display font-black text-blaze leading-none text-[3rem]" style="font-stretch:125%">{i + 1}</span>
            <h3 class="mt-2">{s.t}</h3>
            <p class="text-slate mt-1.5 max-w-[30ch]">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-mist">
    <div class="wrap section md:grid md:grid-cols-[1fr_1.7fr] md:gap-14">
      <div>
        <h2 class="mb-4 md:mb-0 reveal">Common questions</h2>
        <div class="hidden md:block mt-8 reveal">
          <p class="font-display font-extrabold mb-2.5" style="font-stretch:108%">Related services</p>
          <ul class="flex flex-wrap gap-2">
            {service.related.map((id) => <li><a href={`/services/${id}`} class="inline-block rounded-full border-2 border-spruce/25 px-3.5 py-1.5 text-[0.95rem] font-semibold no-underline hover:bg-spruce hover:text-white hover:border-spruce transition-colors">{serviceById[id].name}</a></li>)}
          </ul>
        </div>
      </div>
      <div>
        <Faqs faqs={allFaqs} />
        <div class="md:hidden mt-10">
          <p class="font-display font-extrabold mb-2.5" style="font-stretch:108%">Related services</p>
          <ul class="flex flex-wrap gap-2">
            {service.related.map((id) => <li><a href={`/services/${id}`} class="inline-block rounded-full border-2 border-spruce/25 px-3.5 py-1.5 text-[0.95rem] font-semibold no-underline">{serviceById[id].name}</a></li>)}
          </ul>
        </div>
        <p class="mt-8 text-sm text-slate">Last updated <time datetime={site.lastUpdated}>{new Date(`${site.lastUpdated}T12:00:00`).toLocaleDateString('en-US', { dateStyle: 'long' })}</time> by Kava Construction LLC. Serving Morganton and towns within {site.radiusMiles} miles.</p>
      </div>
    </div>
  </section>

  <CtaBand heading={`Get a free estimate for ${lower}`} service={service.id} />
</Base>

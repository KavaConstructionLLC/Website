---
import { site } from '../data/site';
---
<dialog id="calendar" class="cal" aria-labelledby="calendar-title">
  <div class="cal-head">
    <h2 id="calendar-title" class="!text-[1.2rem]">Pick your estimate time</h2>
    <button type="button" data-cal-close aria-label="Close" class="grid place-items-center w-11 h-11 rounded-[10px] bg-mist">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <iframe title="Kava Construction booking calendar" data-cal-frame></iframe>
  <p class="cal-foot">Calendar not loading? <a data-cal-fallback href={site.calendly} target="_blank" rel="noopener" class="underline font-semibold">Open it here</a> or call <a href={site.phoneHref} class="underline font-semibold">{site.phone}</a>.</p>
</dialog>

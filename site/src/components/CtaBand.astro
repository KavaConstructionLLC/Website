---
import { site } from '../data/site';
const { heading = 'Ready for a price?', service = '' } = Astro.props;
---
<section class="bg-tape text-on-tape relative overflow-hidden">
  <div class="wrap section md:grid md:grid-cols-[1.2fr_1fr] md:items-center md:gap-12">
    <div>
      <h2 class="!text-[clamp(2rem,7vw,3.4rem)]">{heading}</h2>
      <p class="mt-3 mb-6 md:mb-0 text-[1.1rem] font-medium max-w-[34ch]">It takes about a minute, and the estimate is free. Tell us the job, pick a time, and we take it from there.</p>
    </div>
    <div class="space-y-2.5">
      <a href="/book" data-wizard={service} data-source="cta-band" class="btn btn-dark !min-h-[60px] !text-[1.15rem]">
        Get My Free Estimate
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href={site.phoneHref} class="btn border-2 border-on-tape text-on-tape hover:bg-on-tape hover:text-tape-soft">Or call {site.phone}</a>
      <p class="text-center text-sm font-semibold pt-1">Mon to Sat, 8 AM to 5 PM. Se habla español.</p>
    </div>
  </div>
  <div class="ruler" aria-hidden="true" style="background-color:var(--color-spruce-deep);background-image:repeating-linear-gradient(to right,var(--color-tape) 0 2px,transparent 2px 48px),repeating-linear-gradient(to right,var(--color-tape) 0 1px,transparent 1px 12px);height:18px"></div>
</section>
